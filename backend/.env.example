# =========================
# LLM SETTINGS
# =========================
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# =========================
# VECTOR SEARCH
# =========================
VECTOR_TOP_K=5
VECTOR_DB_PATH=vector_db
VECTOR_DIMENSION=384
VECTOR_INDEX_PATH=vector_db/qmof.index
VECTOR_METADATA_PATH=vector_db/metadata.json

# =========================
# ML MODEL
# =========================
MODEL_PATH=app/models/material_classifier.pt

# =========================
# GRAPH SETTINGS
# =========================
K_NEIGHBORS=8

# =========================
# DATASET
# =========================
QMOF_CSV_PATH=../qmof_database/qmof_database/qmof.csv

# Directory containing per-material CIF files (used by /materials/{id}/structure).
# Set this to an absolute path appropriate for the deployment environment.
QMOF_CIF_DIR=

# =========================
# CORS
# =========================
# Comma-separated list of allowed origins, e.g. https://app.example.com,https://admin.example.com
# Do NOT use "*" together with allow_credentials=True in production.
CORS_ORIGINS=http://localhost:3000

# =========================
# EMBEDDINGS
# =========================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =========================
# DATABASE & AUTH
# =========================
# SQLite by default (zero setup). For production use Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/qmof
DATABASE_URL=sqlite:///./qmof.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
